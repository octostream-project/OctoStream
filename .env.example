# Optopus Stream environment variables
# Copy this file to .env and fill in your values.

# TMDB API key (https://www.themoviedb.org/settings/api)
# Optional: if not set, the bundled demo key is used.
VITE_TMDB_API_KEY=

# OpenSubtitles API key (optional, for the subtitles plugin)
VITE_OPENSUBTITLES_API_KEY=

# Repelis scraper server URL (optional)
VITE_REPELIS_SERVER_URL=

# Plurtasko server URL (optional)
VITE_PLURTASKO_SERVER_URL=
