<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Escritura en la carpeta de descarga elegida por el usuario:
         WRITE/READ para API <= 29, MANAGE_EXTERNAL_STORAGE (pantalla
         "Acceso a todos los archivos") para API 30+. App sideloaded — en
         Play Store este permiso estaría restringido. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <application
        android:requestLegacyExternalStorage="true" />
</manifest>
