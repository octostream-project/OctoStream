<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Escritura en la carpeta de descarga elegida por el usuario.
         Misma declaración que Kodi (org.xbmc.kodi): WRITE_EXTERNAL_STORAGE
         SIN maxSdkVersion — así requestPermissions() muestra el diálogo
         runtime real del sistema en TODAS las versiones ("Archivos y
         multimedia" en API 30-32, fotos/vídeos/audio en API 33+), no solo
         en API <= 29. MANAGE_EXTERNAL_STORAGE abre además la pantalla
         "Acceso a todos los archivos" en API 30+. App sideloaded — en
         Play Store este permiso estaría restringido. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <application
        android:requestLegacyExternalStorage="true" />
</manifest>
