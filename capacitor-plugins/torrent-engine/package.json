{
  "name": "@octostream/torrent-engine",
  "version": "1.0.0",
  "description": "Capacitor plugin for P2P torrent streaming on Android (jlibtorrent + local HTTP server)",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
